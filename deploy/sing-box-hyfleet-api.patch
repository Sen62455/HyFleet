new file mode 100644
index 0000000..40c20bf
--- /dev/null
+++ b/experimental/clashapi/hyfleet.go
@@ -0,0 +1,32 @@
+package clashapi
+
+import (
+	"net/http"
+
+	"github.com/sagernet/sing-box/experimental/clashapi/trafficontrol"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/go-chi/render"
+	"github.com/gofrs/uuid/v5"
+)
+
+func hyFleetRouter(trafficManager *trafficontrol.Manager) http.Handler {
+	router := chi.NewRouter()
+	router.Get("/users", func(writer http.ResponseWriter, request *http.Request) {
+		render.JSON(writer, request, map[string]any{
+			"epoch": trafficManager.UserCounterEpoch(), "users": trafficManager.UserSnapshots(),
+		})
+	})
+	router.Delete("/users/{user}", func(writer http.ResponseWriter, request *http.Request) {
+		user := chi.URLParam(request, "user")
+		parsed, err := uuid.FromString(user)
+		if err != nil || parsed.String() != user {
+			render.Status(request, http.StatusBadRequest)
+			render.JSON(writer, request, ErrBadRequest)
+			return
+		}
+		closed := trafficManager.CloseUser(user)
+		render.JSON(writer, request, map[string]any{"closed": closed})
+	})
+	return router
+}
