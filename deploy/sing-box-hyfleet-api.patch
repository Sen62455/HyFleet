diff --git a/experimental/clashapi/trafficontrol/manager.go b/experimental/clashapi/trafficontrol/manager.go
index 6763436..d810ca1 100644
--- a/experimental/clashapi/trafficontrol/manager.go
+++ b/experimental/clashapi/trafficontrol/manager.go
@@ -4,0 +5 @@ import (
+	"sort"
@@ -42,0 +44,3 @@ type Manager struct {
+	usersAccess             sync.Mutex
+	userCounterEpoch        string
+	users                   map[string]*UserSnapshot
@@ -49,0 +54,7 @@ type Manager struct {
+type UserSnapshot struct {
+	User        string `json:"user"`
+	Upload      int64  `json:"upload"`
+	Download    int64  `json:"download"`
+	Connections int64  `json:"connections"`
+}
+
@@ -60,0 +72,6 @@ func (m *Manager) Join(c Tracker) {
+	if metadata.Metadata.User != "" {
+		m.usersAccess.Lock()
+		user := m.loadOrCreateUser(metadata.Metadata.User)
+		user.Connections++
+		m.usersAccess.Unlock()
+	}
@@ -73,0 +91,8 @@ func (m *Manager) Leave(c Tracker) {
+		if metadata.Metadata.User != "" {
+			m.usersAccess.Lock()
+			user := m.loadOrCreateUser(metadata.Metadata.User)
+			if user.Connections > 0 {
+				user.Connections--
+			}
+			m.usersAccess.Unlock()
+		}
@@ -93,0 +119,64 @@ func (m *Manager) Leave(c Tracker) {
+func (m *Manager) PushUserUploaded(user string, size int64) {
+	if user == "" || size <= 0 {
+		return
+	}
+	m.usersAccess.Lock()
+	m.loadOrCreateUser(user).Upload += size
+	m.usersAccess.Unlock()
+}
+
+func (m *Manager) PushUserDownloaded(user string, size int64) {
+	if user == "" || size <= 0 {
+		return
+	}
+	m.usersAccess.Lock()
+	m.loadOrCreateUser(user).Download += size
+	m.usersAccess.Unlock()
+}
+
+func (m *Manager) UserSnapshots() []UserSnapshot {
+	m.usersAccess.Lock()
+	result := make([]UserSnapshot, 0, len(m.users))
+	for _, user := range m.users {
+		result = append(result, *user)
+	}
+	m.usersAccess.Unlock()
+	sort.Slice(result, func(i, j int) bool { return result[i].User < result[j].User })
+	return result
+}
+
+func (m *Manager) UserCounterEpoch() string {
+	m.usersAccess.Lock()
+	defer m.usersAccess.Unlock()
+	if m.userCounterEpoch == "" {
+		m.userCounterEpoch = uuid.Must(uuid.NewV4()).String()
+	}
+	return m.userCounterEpoch
+}
+
+func (m *Manager) CloseUser(user string) int {
+	connections := make([]Tracker, 0)
+	m.connections.Range(func(_ uuid.UUID, value Tracker) bool {
+		if value.Metadata().Metadata.User == user {
+			connections = append(connections, value)
+		}
+		return true
+	})
+	for _, connection := range connections {
+		_ = connection.Close()
+	}
+	return len(connections)
+}
+
+func (m *Manager) loadOrCreateUser(name string) *UserSnapshot {
+	if m.users == nil {
+		m.users = make(map[string]*UserSnapshot)
+	}
+	user := m.users[name]
+	if user == nil {
+		user = &UserSnapshot{User: name}
+		m.users[name] = user
+	}
+	return user
+}
+
