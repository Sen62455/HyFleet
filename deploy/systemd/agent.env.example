# Remove this line after the first successful enrollment.
HYFLEET_ENROLLMENT_TOKEN=replace-before-starting

# S-UI nodes keep this local token for the lifetime of the Agent installation.
HYFLEET_SUI_TOKEN=replace-with-local-s-ui-api-token

# Reality nodes generate this locally during installation. Use at least 32 random bytes.
HYFLEET_REALITY_API_SECRET=replace-with-random-base64url-or-hex-secret
