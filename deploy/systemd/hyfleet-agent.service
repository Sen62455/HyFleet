[Unit]
Description=HyFleet node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyfleet-agent
Group=hyfleet-agent
EnvironmentFile=-/etc/hyfleet/agent.env
EnvironmentFile=-/etc/hyfleet/hy2-stats.env
ExecStart=/usr/local/bin/hyfleet-agent -config /etc/hyfleet/agent.yaml
Restart=always
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hyfleet-agent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
